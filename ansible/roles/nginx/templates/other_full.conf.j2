# 5. Analyze subdomain
server {
    listen 443 ssl http2;
    server_name analyze.caliphauction.com;
    ssl_certificate     /etc/nginx/ssl/caliphauction.com/cloudflare_origin.pem;
    ssl_certificate_key /etc/nginx/ssl/caliphauction.com/cloudflare_origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    location / {
        root /var/www/analyze/caliphauction;
        access_log off;
        try_files $uri $uri/ /index.html;
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }
}