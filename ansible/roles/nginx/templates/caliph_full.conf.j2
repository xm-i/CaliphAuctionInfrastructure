## Full HTTPS configuration for multi-domain setup

# Common TLS settings snippet (can refactor to include file later if desired)
map $host $is_www {
    default 0;
    www.caliphauction.com 1;
}

# WebSocket upgrade mapping for SignalR / other WS endpoints
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 1. Apex (redirect permanently to www over HTTPS)
server {
    listen 443 ssl http2;
    server_name caliphauction.com;
    ssl_certificate     /etc/nginx/ssl/caliphauction.com/cloudflare_origin.pem;
    ssl_certificate_key /etc/nginx/ssl/caliphauction.com/cloudflare_origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    location / { return 301 https://www.caliphauction.com$request_uri; }
}

# 2. WWW (primary frontend)
server {
    listen 443 ssl http2;
    server_name www.caliphauction.com;
    ssl_certificate     /etc/nginx/ssl/caliphauction.com/cloudflare_origin.pem;
    ssl_certificate_key /etc/nginx/ssl/caliphauction.com/cloudflare_origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    location / { root {{ nginx_front_root }}; try_files $uri $uri/ /index.html; }
    location /cdn/ { alias {{ nginx_cdn_root }}/; access_log off; expires 30d; add_header Cache-Control "public, max-age=2592000"; }
    location /api/ {
        proxy_pass {{ nginx_backend_upstream }}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # Dedicated SignalR hub path (adjust if your app uses a different base path)
    location ^~ /hubs/ {
        proxy_pass {{ nginx_backend_upstream }}/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }
}

# 3. API subdomain
server {
    listen 443 ssl http2;
    server_name api.caliphauction.com;
    ssl_certificate     /etc/nginx/ssl/caliphauction.com/cloudflare_origin.pem;
    ssl_certificate_key /etc/nginx/ssl/caliphauction.com/cloudflare_origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    location / {
        # All paths proxy to backend API (includes SignalR hubs if accessed via api subdomain)
        proxy_pass {{ nginx_backend_upstream }}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }
}

# 4. CDN subdomain
server {
    listen 443 ssl http2;
    server_name cdn.caliphauction.com;
    ssl_certificate     /etc/nginx/ssl/caliphauction.com/cloudflare_origin.pem;
    ssl_certificate_key /etc/nginx/ssl/caliphauction.com/cloudflare_origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    location / { root {{ nginx_cdn_root }}; access_log off; expires 30d; add_header Cache-Control "public, max-age=2592000"; try_files $uri $uri/ =404; }
}
